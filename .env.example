# Supabase public project configuration
# Copy to .env.local for local development.
# Never place the service_role/secret key or database password in VITE_ variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-public-key

# Cloudflare Turnstile public site key (safe to expose in the browser).
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key
